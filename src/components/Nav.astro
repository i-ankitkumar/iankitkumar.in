---
import { SITE } from '~/lib/site';

const navItems: { href: string; label: string }[] = [
  { href: '/work', label: 'Work' },
  { href: '/experience', label: 'Experience' },
  { href: '/experiments', label: 'Experiments' },
  { href: '/tools', label: 'Tools' },
  { href: '/certs', label: 'Certifications' },
  { href: '/contact', label: 'Contact' },
  { href: SITE.blog, label: 'Blog ↗' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// A detail route (/work/splunk-multisite-migration/) belongs to its
// section (/work). Mark the section current so the nav keeps showing
// where the visitor is once they go deep.
const sectionFor = (path: string) => {
  const parts = path.split('/').filter(Boolean);
  return parts.length > 1 ? `/${parts[0]}` : path;
};
const currentSection = sectionFor(currentPath);
---

<header class="site-header">
  <div class="container">
    <a href="/" class="brand" aria-label={`${SITE.name} — home`}>
      Ankit Kumar<span class="dot">.</span>
    </a>
    <nav class="site-nav" id="site-nav" aria-label="Primary">
      {navItems.map((item) => {
        const itemPath = item.href.replace(/\/$/, '') || '/';
        const isExternal = item.href.startsWith('http');
        const isCurrent =
          !isExternal && (itemPath === currentPath || itemPath === currentSection);
        return (
          <a
            href={item.href}
            aria-current={isCurrent ? 'page' : undefined}
            target={isExternal ? '_blank' : undefined}
            rel={isExternal ? 'noopener' : undefined}
          >
            {item.label}
          </a>
        );
      })}
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Toggle dark mode"
        aria-pressed="false"
      >
        <span data-theme-label>Theme</span>
      </button>
    </nav>
    <button
      class="nav-toggle"
      type="button"
      data-nav-toggle
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="nav-toggle-bars" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');
  const setOpen = (open: boolean) => {
    nav?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  // The nav precedes the toggle in the DOM, so a keyboard user who opens
  // the menu and presses Tab lands in the page body instead of the menu
  // they just revealed. Move focus into the menu on open, and back to
  // the toggle on Escape.
  const focusFirstItem = () => {
    const first = nav?.querySelector<HTMLAnchorElement>('a');
    first?.focus();
  };
  toggle?.addEventListener('click', () => {
    const open = !nav?.classList.contains('is-open');
    setOpen(open);
    if (open) focusFirstItem();
    else toggle?.focus();
  });
  // Close the menu after following a link.
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName === 'A') setOpen(false);
  });
  // Close on Escape.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
  // Reset state when the viewport grows past the mobile breakpoint.
  const mq = matchMedia('(min-width: 56rem)');
  mq.addEventListener('change', () => {
    if (mq.matches) setOpen(false);
  });
</script>
