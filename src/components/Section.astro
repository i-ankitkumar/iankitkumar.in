---
export interface Props {
  title: string;
  intro?: string;
  id?: string;
  /** Register letter for the report ("A", "B", ...). */
  num?: string;
}

const { title, intro, id, num } = Astro.props;
---

<section class="page-section" id={id} aria-labelledby={id ? `${id}-heading` : undefined}>
  <div class="container">
    <header class="section-head">
      <div class="section-head-main">
        {num && <span class="section-num" aria-hidden="true">{num}</span>}
        <h2 class="title" id={id ? `${id}-heading` : undefined}>{title}</h2>
      </div>
      {intro && <p class="section-intro">{intro}</p>}
    </header>
    <slot />
  </div>
</section>
