---
export interface Props {
  num?: string;
  title: string;
  intro?: string;
  id?: string;
}

const { num, title, intro, id } = Astro.props;
---

<section class="page-section" id={id} aria-labelledby={id ? `${id}-heading` : undefined}>
  <div class="container">
    <header class="section-head">
      {num && <span class="num">§ {num}</span>}
      <div>
        <h2 class="title" id={id ? `${id}-heading` : undefined}>{title}</h2>
        {intro && <p class="muted" style="margin-top:.5rem; max-width:60ch; line-height:1.65;">{intro}</p>}
      </div>
    </header>
    <slot />
  </div>
</section>