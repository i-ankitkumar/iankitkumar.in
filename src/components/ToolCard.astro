---
import type { CollectionEntry } from 'astro:content';
import ConfirmMark from './ConfirmMark.astro';

export interface Props {
  /** 'h2' on a listing page; 'h3' inside a <Section> that already has an h2. */
  headingLevel?: 'h2' | 'h3';
  tool: CollectionEntry<'tools'>;
}

const { tool, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const { data } = tool;

const statusLabel: Record<string, string> = {
  live: 'Live',
  beta: 'Beta',
  'in-progress': 'In progress',
  archived: 'Archived',
};
---

<article class="project-card reveal" data-confirm={data.confirm || undefined}>
  <span class="type">Tool</span>
  <span class="status">{statusLabel[data.status] ?? data.status}</span>
  <Heading>
    <a href={`/tools/${tool.id}/`}>{data.name}</a>
    <ConfirmMark confirm={data.confirm} />
  </Heading>
  <p>{data.summary}</p>
  {data.stack.length > 0 && (
    <div class="tags">
      {data.stack.slice(0, 5).map((t) => <span class="tag">{t}</span>)}
    </div>
  )}
</article>
