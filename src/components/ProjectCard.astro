---
import type { CollectionEntry } from 'astro:content';
import ConfirmMark from './ConfirmMark.astro';

export interface Props {
  project: CollectionEntry<'projects'>;
  size?: 'sm' | 'md';
  /**
   * Heading level for the card title.
   * 'h2' on a listing page (the h1 is followed straight by the cards).
   * 'h3' inside a <Section>, which already renders an h2 title.
   */
  headingLevel?: 'h2' | 'h3';
  /**
   * Marks the card as the current direction — the AI/software track.
   * Renders a "current direction" label and a left rule, so the pivot
   * is legible without changing the authored project data.
   */
  isCurrent?: boolean;
}

const { project, size = 'md', headingLevel = 'h2', isCurrent = false } = Astro.props;
const Heading = headingLevel;
const { data, id } = project;

const statusLabel: Record<string, string> = {
  live: 'Live',
  shipped: 'Shipped',
  'in-progress': 'In progress',
  archived: 'Archived',
  research: 'Research',
};
---

<a class={`project-card reveal ${size === 'sm' ? 'is-visible' : ''} ${isCurrent ? 'is-current' : ''}`} href={`/work/${id}/`} data-confirm={data.confirm || undefined}>
  <span class="type">{data.type}</span>
  {isCurrent && <span class="type current-flag">Current direction</span>}
  {data.status && <span class="status">{statusLabel[data.status] ?? data.status}</span>}
  {/* The verb: a short imperative phrase stating what the record does.
      It sits directly above the name with no gap between them, so the
      two read as one block — what the record does, then what it is
      called — the way the reference design's library cards do. */}
  <div class="verb-block">
    {data.verb && <p class="verb">{data.verb}</p>}
    <Heading>
      {data.name}
      <ConfirmMark confirm={data.confirm} label={data.confirm ? 'verify' : undefined} />
    </Heading>
  </div>
  <p>{data.summary}</p>
  {data.tags.length > 0 && (
    <div class="tags">
      {data.tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  )}
</a>

<style>
  .project-card.sm { padding: var(--s-5); }
  .project-card.sm :global(h2), .project-card.sm :global(h3) { font-size: var(--t-lg); }
</style>