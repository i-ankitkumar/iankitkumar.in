---
import { SITE } from '~/lib/site';

const year = new Date().getFullYear();
const builtWith = ['Astro 5', 'TypeScript', 'Cloudflare Pages'];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <span class="doctype">Prüfprotokoll · Inspection Report</span>
      <span class="footer-subject">{SITE.name} — {SITE.role}</span>
    </div>
    <div class="links">
      <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
      <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a href={SITE.blog} target="_blank" rel="noopener">Blog</a>
      <a href={`mailto:${SITE.email}`}>Email</a>
      <a href={SITE.resumeUrl} target="_blank" rel="noopener">Resume (PDF)</a>
    </div>
    <div class="meta-line">
      <span>© {year} {SITE.name}</span>
      <span>{SITE.locationShort}</span>
      <span>Built with {builtWith.join(' · ')}</span>
    </div>
  </div>
</footer>
