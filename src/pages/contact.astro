---
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import ReportHead from '~/components/ReportHead.astro';
import { SITE } from '~/lib/site';

// The contact methods, in one place, so the count in the report furniture
// line cannot drift from what the page actually renders.
const CONTACT_METHODS = ['email', 'phone', 'linkedin', 'github', 'resume', 'blog'];

---

<Base title="Contact" description={`Contact details for ${SITE.name}: email, LinkedIn, GitHub, resume.`}>
  <Nav slot="header" />

  <ReportHead
    reportType={`Prüfprotokoll · Contact · ${CONTACT_METHODS.length} methods`}
    title="The fastest route is email."
    lead="I'm happy to talk about a role, a thing you're working on, or a question about Splunk / Terraform / MCP."
  >
    <div slot="actions" class="actions" style="margin-top: var(--s-5);">
      <a class="btn primary" href={`mailto:${SITE.email}`}>{SITE.email} <span class="arr">→</span></a>
      <a class="btn" href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="btn" href={SITE.github} target="_blank" rel="noopener">GitHub</a>
      <a class="btn" href={SITE.resumeUrl} target="_blank" rel="noopener">Resume (PDF)</a>
    </div>
  </ReportHead>

  <section class="page-section" style="padding-block: var(--s-5) var(--s-9);">
    <div class="container">
      <div class="stack-lg contact-method" style="max-width: var(--measure);">
        <div>
          <h2 class="contact-label" style="margin: 0;">Email</h2>
          <p class="lead" style="margin-top: var(--s-2);">
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            <span class="muted" style="font-family: var(--font-mono); font-size: var(--t-xs); display: block; margin-top: 0.4rem;">
              Use this one. It is routed by Cloudflare straight to my inbox.
            </span>
          </p>
        </div>

        <div>
          <h2 class="contact-label" style="margin: 0;">Phone</h2>
          <p class="lead" style="margin-top: var(--s-2);">
            <a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a>
            <span class="muted" style="font-family: var(--font-mono); font-size: var(--t-xs); display: block; margin-top: 0.4rem;">
              India number, so it is best for a WhatsApp message or a late call.
            </span>
          </p>
        </div>

        <div>
          <h2 class="contact-label" style="margin: 0;">LinkedIn</h2>
          <p class="lead" style="margin-top: var(--s-2);">
            <a href={SITE.linkedin} target="_blank" rel="noopener">{SITE.linkedin.replace('https://', '')}</a>
          </p>
        </div>

        <div>
          <h2 class="contact-label" style="margin: 0;">GitHub</h2>
          <p class="lead" style="margin-top: var(--s-2);">
            <a href={SITE.github} target="_blank" rel="noopener">{SITE.github.replace('https://', '')}</a>
          </p>
        </div>

        <div>
          <h2 class="contact-label" style="margin: 0;">Resume</h2>
          <p class="lead" style="margin-top: var(--s-2);">
            <a href={SITE.resumeUrl} target="_blank" rel="noopener">Download PDF ↓</a>
          </p>
        </div>

        <div>
          <h2 class="contact-label" style="margin: 0;">Blog</h2>
          <p class="lead" style="margin-top: var(--s-2);">
            <a href={SITE.blog} target="_blank" rel="noopener">{SITE.blog.replace('https://', '')} ↗</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
