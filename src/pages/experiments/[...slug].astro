---
import { getCollection, render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';

export async function getStaticPaths() {
  const experiments = await getCollection('experiments');
  return experiments.map((exp) => ({
    params: { slug: exp.id },
    props: { exp },
  }));
}

const { exp } = Astro.props;
const { Content } = await render(exp);
const { data } = exp;

const statusLabel: Record<string, string> = {
  live: 'Live',
  shipped: 'Shipped',
  'in-progress': 'In progress',
  experimental: 'Experimental',
  archived: 'Archived',
};

const categoryLabel: Record<string, string> = {
  'ai-agent': 'AI Agent',
  mcp: 'MCP',
  'security-tooling': 'Security Tooling',
  'ml-security': 'ML Security',
  other: 'Other',
};

// The eyebrow carries the category. When the title already leads with
// it ("MCP server: Splunk query planner" under "MCP") repeating it is a
// stutter, so the eyebrow is dropped in that case.
const category = data.type ?? categoryLabel[data.category] ?? data.category;
const showCategory = !data.name.toLowerCase().startsWith(category.toLowerCase());

const blocks: { title: string; body?: string }[] = [
  { title: 'Problem', body: data.problem },
  { title: 'Architecture', body: data.architecture },
  { title: 'Implementation', body: data.implementation },
  { title: 'Results', body: data.results },
];
---

<Base title={data.name} description={data.summary}>
  <Nav slot="header" />

  <section class="hero" style="padding-block: clamp(var(--s-7), 7vw, var(--s-9)) clamp(var(--s-5), 4vw, var(--s-7));">
    <div class="container">
      <p style="margin: 0 0 var(--s-4);">
        <a href="/experiments/" class="muted section-more" style="font-family: var(--font-mono); font-size: var(--t-xs);">← All experiments</a>
      </p>
      {showCategory && <span class="eyebrow">{category}</span>}
      <h1 class="display" style="font-size: var(--t-page-display); margin-top: var(--s-3);">{data.name}</h1>
      <p class="lead" style="margin-top: var(--s-5);">{data.summary}</p>
      <div class="actions" style="margin-top: var(--s-5);">
        {data.links.map((l) => (
          <a class="btn" href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
            {l.label}{l.external && <span class="arr"> ↗</span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section" style="padding-block: var(--s-5) var(--s-9);">
    <div class="container">
      <div class="proj-detail">
        <aside class="meta">
          <dl style="margin:0;">
            <dt>Status</dt>
            <dd><span style="color: var(--accent); font-family: var(--font-mono);">{statusLabel[data.status] ?? data.status}</span></dd>
            {data.period && (<><dt>Period</dt><dd>{data.period}</dd></>)}
            {data.stack.length > 0 && (
              <>
                <dt>Stack</dt>
                <dd class="tags">
                  {data.stack.map((s) => (
                    <span class="tag">{s}</span>
                  ))}
                </dd>
              </>
            )}
          </dl>
        </aside>
        <div class="prose">
          {blocks.filter((b) => b.body).map((b) => (
            <h2>{b.title}</h2>
            <p>{b.body}</p>
          ))}
          {Content && <Content />}
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
