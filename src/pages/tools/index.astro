---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import ToolCard from '~/components/ToolCard.astro';
import ReportHead from '~/components/ReportHead.astro';
import { SITE } from '~/lib/site';

const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);

---

<Base title="Tools" description={`Open-source tools by ${SITE.name}: Telegram bots and automation built for real daily friction.`}>
  <Nav slot="header" />

  <ReportHead
    reportType={`Prüfprotokoll · Tools · ${tools.length} entries`}
    title="Things I built to stop doing them by hand."
    lead="Each one is open source, installable in a couple of commands, and solves a specific piece of daily friction rather than a general problem. If it is listed here, it runs on my own machine first."
  />

  <section class="page-section" style="padding-block: var(--s-5) var(--s-9);">
    <div class="container">
      <div class="project-grid">
        {tools.map((tool) => <ToolCard tool={tool} />)}
      </div>
      <p class="muted" style="margin-top: var(--s-6); max-width: 60ch;">
        Tools are additive — they sit on top of services you already use, and they never act without you saying so.
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
