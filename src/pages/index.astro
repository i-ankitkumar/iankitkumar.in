---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import Section from '~/components/Section.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import ExperimentCard from '~/components/ExperimentCard.astro';
import CertItem from '~/components/CertItem.astro';
import { SITE } from '~/lib/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).slice(0, 4);

const experiments = (await getCollection('experiments')).sort((a, b) => a.data.order - b.data.order);

const certs = (await getCollection('certs'))
  .sort((a, b) => {
    const rank = { active: 0, 'in-progress': 1, expired: 2 } as Record<string, number>;
    return (rank[a.data.status] ?? 9) - (rank[b.data.status] ?? 9) || a.data.order - b.data.order;
  });

const skillGroups: { title: string; items: string[] }[] = [
  {
    title: 'Cloud & Infrastructure',
    items: ['Azure (IaaS/PaaS — VMs, VNets, AKS, Functions, Key Vaults)', 'AWS (EC2, SSM, S3, IAM, VPC, CloudWatch, ECS)', 'Terraform (IaC, HashiCorp Certified)', 'Docker · Kubernetes · Helm'],
  },
  {
    title: 'Observability',
    items: ['Splunk Enterprise (multi-site clustering, SOC2, dashboards)', 'Microsoft Sentinel', 'Azure Monitor · Log Analytics', 'Grafana · Prometheus', 'On-call / P1/P2 incident ownership · RCA'],
  },
  {
    title: 'DevOps & CI/CD',
    items: ['Azure DevOps Pipelines', 'GitHub Actions', 'Jenkins', 'Ansible', 'YAML CI/CD · GitOps', 'Helm · ServiceNow'],
  },
  {
    title: 'Operating Systems',
    items: ['RHEL (RHCSA)', 'Windows Server', 'SCCM / MECM', 'Workspace One', 'Tanium'],
  },
  {
    title: 'Scripting & Automation',
    items: ['Python (Boto3, Azure SDK)', 'PowerShell', 'Bash / UNIX Shell', 'Runbook development', 'Patch automation · tech-debt scanning'],
  },
  {
    title: 'Security & Compliance',
    items: ['SOC2 compliance · audit-ready telemetry', 'Microsoft Sentinel', 'CyberArk · Azure Key Vault · HashiCorp Vault', 'Azure Entra ID (SSO) · Zero-Trust', 'SaaS security controls'],
  },
  {
    title: 'AI & Tooling',
    items: ['Model Context Protocol (MCP)', 'AI-assisted Splunk tooling', 'LLM structured-output pipelines', 'Paperclip · Honcho · GitNexus · Hermes', 'Pandas · NumPy · scikit-learn · TensorFlow / Keras'],
  },
];
---

<Base
  title={undefined}
  description={SITE.description}
>
  <Nav slot="header" />

  <!-- HERO -->
  <section class="hero">
    <div class="container stack">
      <img
        class="portrait"
        src={SITE.photoUrl}
        alt={`${SITE.name} — portrait`}
        width="96"
        height="96"
        loading="eager"
        decoding="async"
      />
      <div class="meta">
        <span class="meta-item"><strong>Infrastructure → Software &amp; AI Engineering</strong></span>
        <span class="meta-item"><strong>Splunk · Azure · AWS · Terraform</strong></span>
        <span class="meta-item"><strong>20K+ endpoints</strong> · 99.9% upgrade success</span>
        <span class="meta-item"><strong>Pune</strong> to Germany</span>
      </div>
      <h1 class="display">
        Infrastructure engineer<br />
        shipping software<br />
        <span style="color: var(--accent); font-style: italic;">&amp; AI tooling.</span>
      </h1>
      <p class="lead lede">
        Running Splunk multi-site clusters and Azure foundations at Wolters Kluwer. Building MCP, AI-assisted ops, and runbooks that scale.
      </p>
      <div class="actions">
        <a class="btn primary" href={SITE.resumeUrl} target="_blank" rel="noopener">
          Resume <span class="arr">↓</span>
        </a>
        <a class="btn" href={SITE.github} target="_blank" rel="noopener">GitHub</a>
        <a class="btn" href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn" href={`mailto:${SITE.email}`}>Email</a>
      </div>
      <p class="muted" style="margin-top: var(--s-7); font-family: var(--font-mono); font-size: var(--t-xs); letter-spacing: 0.06em;">
        Currently at Wolters Kluwer · {SITE.languages}
      </p>
    </div>
  </section>

  <!-- ABOUT / POSITIONING -->
  <Section title="About" id="about" intro="A short version of where I've been and where I'm heading.">
    <div class="prose" style="max-width: var(--measure);">
      <p>
        I'm an infrastructure engineer with five years on platforms that have to stay up. Most of that has been at Wolters Kluwer in Pune — Splunk multi-site clusters, Azure landing zones, Terraform across 2,500+ subscriptions, and the runbooks that stop surprise incidents. Before that, Colgate GBS: 20,000+ Windows endpoints, 79 factories, 70 countries, and a lot of zero-day patch cycles.
      </p>
      <p>
        At WK I drove an <strong>AI-assisted automation initiative</strong> for pipeline-failure detection, log analysis, and release tagging — and I'm building on top of that with software-engineering work: an MCP server that lets language models query Splunk the way an SRE would, and a small Python pipeline that turns LLM structured output into enriched security alerts.
      </p>
      <p>
        My daily work stack is multi-agent too: <strong>Paperclip</strong> for orchestration, <strong>Honcho</strong> for persistent cross-agent memory, <strong>GitNexus</strong> for codebase knowledge graphs, <strong>Hermes</strong> as the agent runtime — with specialised agents for dev, qa, infra, marketing, and design. Same MCP-and-shared-memory primitives as the WK work, just with more agents on a personal workstation. Five years of platform engineering is what I'm bringing. Software and AI engineering is where I'm going.
      </p>
      <p>
        Open to software and AI engineering roles in Germany — relocating from India.
      </p>
    </div>
  </Section>

  <!-- FEATURED WORK -->
  <Section title="Selected work" id="work" intro="Four pieces I'd talk through in an interview. The full list is on the work page.">
    <div class="project-grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
    <p class="muted" style="margin-top: var(--s-6);">
      <a href="/work/">All projects →</a>
    </p>
  </Section>

  <!-- SKILLS -->
  <Section title="Stack" id="stack" intro="Tools and categories I work with day-to-day.">
    <div class="skill-grid">
      {skillGroups.map((group) => (
        <div class="skill-group reveal">
          <h3>{group.title}</h3>
          <ul>
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <!-- CERTS PREVIEW -->
  <Section title="Certifications" id="certs" intro="Active first, in-progress next, expired last.">
    <div class="cert-list">
      {certs.map((c) => <CertItem cert={c} />)}
    </div>
  </Section>

  <!-- EXPERIMENTS PREVIEW -->
  <Section title="Experiments" id="experiments" intro="Software and AI engineering work outside my day job.">
    <div class="project-grid">
      {experiments.map((exp) => <ExperimentCard exp={exp} />)}
    </div>
    <p class="muted" style="margin-top: var(--s-6);">
      <a href="/experiments/">All experiments →</a>
    </p>
  </Section>

  <!-- CONTACT CTA -->
  <Section title="Get in touch" id="contact" intro="The fastest route is email. The slower routes are linked below.">
    <div class="stack" style="margin-top: var(--s-3);">
      <p class="lead" style="max-width: 50ch;">
        I'm happy to talk about a role, a project, or a thing you're working on.
      </p>
      <div class="actions">
        <a class="btn primary" href={`mailto:${SITE.email}`}>
          {SITE.email} <span class="arr">→</span>
        </a>
        <a class="btn" href={SITE.github} target="_blank" rel="noopener">GitHub</a>
        <a class="btn" href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn" href={SITE.resumeUrl} target="_blank" rel="noopener">Resume (PDF)</a>
      </div>
      <p class="muted" style="font-family: var(--font-mono); font-size: var(--t-xs);">
        Direct (real inbox): {SITE.emailDirect}
      </p>
    </div>
  </Section>

  <Footer slot="footer" />
</Base>

<style is:global>
  .prose p { margin: 0 0 var(--s-5); line-height: var(--lh-loose); }
  .prose p:last-child { margin-bottom: 0; }
</style>