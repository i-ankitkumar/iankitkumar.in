---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import ExperienceCard from '~/components/ExperienceCard.astro';
import ReportHead from '~/components/ReportHead.astro';
import { SITE } from '~/lib/site';

const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);

---

<Base title="Experience" description={`Career timeline for ${SITE.name}: Wolters Kluwer, Colgate GBS, with focus on Splunk, Azure, Terraform, and reliability engineering.`}>
  <Nav slot="header" />

  <ReportHead
    reportType={`Prüfprotokoll · Experience Register · ${roles.length} roles`}
    title="Where I've worked, what I owned."
    lead="Most recent first. Each role has a one-line summary, the work I owned, and the tools I used."
  />

  <section class="page-section" style="padding-block: var(--s-5) var(--s-9);">
    <div class="container">
      <div class="timeline">
        {roles.map((role) => (
          <div id={role.id}>
            <ExperienceCard role={role} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
