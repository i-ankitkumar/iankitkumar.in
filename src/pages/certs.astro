---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import CertItem from '~/components/CertItem.astro';
import ReportHead from '~/components/ReportHead.astro';
import { SITE } from '~/lib/site';

const certs = (await getCollection('certs')).sort((a, b) => {
  const rank = { active: 0, 'in-progress': 1, expired: 2 } as Record<string, number>;
  return (rank[a.data.status] ?? 9) - (rank[b.data.status] ?? 9) || a.data.order - b.data.order;
});

---

<Base title="Certifications" description={`Cloud and infrastructure certifications held by ${SITE.name}: Terraform Associate, AZ-104, RHCSA, AZ-900, AI-900, AZ-400 in progress.`}>
  <Nav slot="header" />

  <ReportHead
    reportType={`Prüfprotokoll · Credentials · ${certs.length} entries`}
    title="Verified, in order of recency."
    lead="Active first. In-progress next. Expired last — kept on the page because they shaped what I built on top."
  />

  <section class="page-section" style="padding-block: var(--s-5) var(--s-9);">
    <div class="container">
      <div class="cert-list">
        {certs.map((c) => <CertItem cert={c} />)}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
