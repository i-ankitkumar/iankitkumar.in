---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Nav from '~/components/Nav.astro';
import Footer from '~/components/Footer.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import ReportHead from '~/components/ReportHead.astro';
import { SITE } from '~/lib/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const CURRENT_DIRECTION = 'ai-office-stack';

---

<Base title="Work" description={`Selected engineering projects by ${SITE.name}: Splunk multi-site migration, SOC2 dashboards, global endpoint ops, and ML security research.`}>
  <Nav slot="header" />

  <ReportHead
    reportType={`Prüfprotokoll · Work Register · ${projects.length} entries`}
    title="Projects, in order of how often I talk about them."
    lead="Production work comes first (Wolters Kluwer, Colgate GBS). Research and personal work follow. Every entry has a problem, an architecture, an implementation, and a result — the same shape I'd use to brief a hiring manager."
  />

  <section class="page-section" style="padding-block: var(--s-5) var(--s-9);">
    <div class="container">
      <div class="project-grid">
        {projects.map((p) => (
          <ProjectCard project={p} isCurrent={p.id === CURRENT_DIRECTION} />
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
